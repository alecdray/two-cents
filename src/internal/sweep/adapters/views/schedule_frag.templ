package views

import (
	"strconv"
	"time"

	"github.com/alecdray/two-cents/src/internal/schedule"
)

// ScheduleProps carries everything the schedule region renders: the declared
// items, and at most one inline validation message — scoped either to the add
// form or to the row whose edit failed, so a bad amount reports itself where it
// was typed.
type ScheduleProps struct {
	Items []schedule.Item
	// Windows carries each active item's reconcilable occurrences. An item with
	// none — inactive, or nothing has fallen due inside its lookback — simply
	// renders without the block. The compact row also reads this to tell
	// whether a dateless item's open month has settled.
	Windows []schedule.ItemOccurrences
	// AmountStates carries the two facts a resolved Item.Amount cannot answer
	// on its own — whether an override is declared, and whether a computed
	// figure exists at all — keyed by item id ([ADR-0031]). An item missing
	// from the map reads as neither, which only happens without a ledger
	// configured.
	AmountStates map[string]schedule.AmountState
	// Next carries each dated item's next projected occurrence, keyed by item
	// id. A dateless item has no entry: it has no fixed date to project
	// ([ADR-0031]).
	Next      map[string]time.Time
	AddError  string
	RowErrID  string
	RowErrMsg string
}

// window returns the occurrences belonging to one item.
func (p ScheduleProps) window(id string) schedule.ItemOccurrences {
	for _, w := range p.Windows {
		if w.Item.ID == id {
			return w
		}
	}
	return schedule.ItemOccurrences{}
}

// amountState returns the amount state belonging to one item, the zero value
// (no override, nothing computed) when the map carries none for it.
func (p ScheduleProps) amountState(id string) schedule.AmountState {
	return p.AmountStates[id]
}

// nextOccurrence returns the next projected date belonging to one item, ok
// false when the item has none to project.
func (p ScheduleProps) nextOccurrence(id string) (time.Time, bool) {
	t, ok := p.Next[id]
	return t, ok
}

// rowError returns the validation message belonging to one row, empty when the
// failure (if any) belongs elsewhere.
func (p ScheduleProps) rowError(id string) string {
	if p.RowErrMsg != "" && p.RowErrID == id {
		return p.RowErrMsg
	}
	return ""
}

// ScheduleFrag is the swappable schedule region: the declared recurring checking
// activity the next run's timeline is built from, with a form to add one and a
// form per row to edit or remove it.
//
// It lives on /sweep because the sweep is its only consumer — a declared item
// means nothing anywhere else in the app.
templ ScheduleFrag(props ScheduleProps) {
	<section id={ ScheduleRegionID() } data-testid="sweep-schedule" class="flex flex-col gap-4 pt-2 border-t border-base-200">
		<div class="flex flex-col gap-1">
			<h2 class="text-lg font-semibold text-default">Schedule</h2>
			<p class="text-sm text-muted">
				The bills, income, and standing transfers that move through checking on a known date.
				Declare what is actually scheduled — not what you intend to do.
			</p>
		</div>
		@scheduleAddForm(props.AddError)
		if len(props.Items) > 0 {
			<div data-testid="schedule-list" class="flex flex-col rounded-box bg-base-200 divide-y divide-base-300">
				for _, item := range props.Items {
					{{ next, hasNext := props.nextOccurrence(item.ID) }}
					@scheduleRow(item, props.rowError(item.ID), props.window(item.ID), props.amountState(item.ID), next, hasNext)
				}
			</div>
		} else {
			<p data-testid="schedule-empty" class="text-sm text-muted py-2">
				Nothing declared yet. Without a schedule the sweep still works — it just only knows about your cards.
			</p>
		}
	</section>
}

// scheduleAddForm declares a new item. It posts the whole region back, so a
// validation failure re-renders in place with the message beside the fields.
templ scheduleAddForm(errMsg string) {
	<form
		data-testid="schedule-add-form"
		class="flex flex-col gap-3 rounded-box bg-base-200 p-3"
		hx-post="/sweep/schedule"
		hx-target={ "#" + ScheduleRegionID() }
		hx-swap="outerHTML"
		x-data="{ cadence: 'monthly' }"
	>
		@scheduleFields("schedule-add", schedule.Item{Direction: schedule.DirectionOut, Cadence: schedule.CadenceMonthly})
		if errMsg != "" {
			@scheduleInlineError("schedule-add-error", errMsg)
		}
		<button type="submit" data-testid="schedule-add-submit" class="btn btn-primary btn-sm self-start">Add to schedule</button>
	</form>
}

// scheduleRow renders one declared item as a single scannable line: its
// direction, its amount labeled by which of the four states it's in, a
// cadence summary, and its next projected date — a quick read of what's
// declared and its current status, with the full form and occurrence history
// reached through the edit affordance instead of sitting expanded inline
// ([ADR-0031]).
templ scheduleRow(item schedule.Item, errMsg string, window schedule.ItemOccurrences, state schedule.AmountState, next time.Time, hasNext bool) {
	<div data-testid="schedule-row" class="flex items-start justify-between gap-3 p-3">
		<div class="flex flex-col gap-1 min-w-0">
			<div class="flex items-center gap-2 flex-wrap">
				<span data-testid="schedule-row-direction" class={ scheduleDirectionBadgeClass(item.Direction) }>{ scheduleDirectionLabel(item.Direction) }</span>
				<span data-testid="schedule-row-name" class="font-medium text-default truncate">{ item.Name }</span>
				if !item.Active {
					<span data-testid="schedule-row-inactive" class="badge badge-sm badge-ghost">Off timeline</span>
				}
			</div>
			<div class="flex items-center gap-2 flex-wrap text-xs text-muted">
				<span data-testid="schedule-row-cadence">{ scheduleCadenceSummary(item, window) }</span>
				if hasNext {
					<span data-testid="schedule-row-next">{ next.Format("Jan 2") }</span>
				}
			</div>
			if errMsg != "" {
				@scheduleInlineError("schedule-row-error", errMsg)
			}
		</div>
		<div class="flex items-center gap-3 shrink-0">
			<div class="flex flex-col items-end gap-0.5">
				<span data-testid="schedule-row-amount" class="font-medium tabular-nums text-default">{ scheduleAmountLabel(item) }</span>
				<span data-testid="schedule-row-amount-state" class="text-xs text-muted">{ scheduleAmountStateLabel(state) }</span>
			</div>
			<button
				type="button"
				data-testid="schedule-row-edit"
				class="btn btn-ghost btn-xs"
				disabled
			>Edit</button>
		</div>
	</div>
}

// scheduleFields is the one definition of an item's inputs, shared by the add
// form and every row — so the two can never drift into accepting different
// things. The cadence select drives which date field is shown through the
// enclosing form's Alpine state; both are always submitted, and the service
// keeps only the one the cadence uses.
templ scheduleFields(testid string, item schedule.Item) {
	<div data-testid={ testid + "-fields" } class="flex flex-col gap-2">
		<input
			type="text"
			name="name"
			value={ item.Name }
			placeholder="Rent, Paycheck, Savings transfer…"
			data-testid={ testid + "-name" }
			class="input input-bordered input-sm w-full"
		/>
		<div class="flex gap-2 flex-wrap">
			<select name="direction" data-testid={ testid + "-direction" } class="select select-bordered select-sm">
				<option value="out" selected?={ item.Direction != schedule.DirectionIn }>Goes out</option>
				<option value="in" selected?={ item.Direction == schedule.DirectionIn }>Comes in</option>
			</select>
			<input
				type="number"
				name="amount"
				step="0.01"
				min="0"
				value={ scheduleAmountValue(item) }
				placeholder="Amount"
				data-testid={ testid + "-amount" }
				class="input input-bordered input-sm w-32"
			/>
		</div>
		<div class="flex gap-2 flex-wrap items-center">
			<select
				name="cadence"
				data-testid={ testid + "-cadence" }
				class="select select-bordered select-sm"
				x-model="cadence"
			>
				<option value="monthly" selected?={ item.Cadence != schedule.CadenceBiweekly }>Monthly</option>
				<option value="biweekly" selected?={ item.Cadence == schedule.CadenceBiweekly }>Every 2 weeks</option>
			</select>
			<label x-show="cadence === 'monthly'" class="flex items-center gap-2">
				<span class="text-sm text-muted">on day</span>
				<input
					type="number"
					name="day_of_month"
					min="1"
					max="31"
					value={ scheduleDayValue(item) }
					data-testid={ testid + "-day" }
					class="input input-bordered input-sm w-20"
				/>
			</label>
			<label x-show="cadence === 'biweekly'" class="flex items-center gap-2">
				<span class="text-sm text-muted">last fell on</span>
				<input
					type="date"
					name="anchor_date"
					value={ scheduleAnchorValue(item) }
					data-testid={ testid + "-anchor" }
					class="input input-bordered input-sm"
				/>
			</label>
		</div>
		<p class="text-xs text-subtle">
			Use the amount you would not want to be short of: the most a bill could be, the least a paycheck could be.
		</p>
	</div>
}

// scheduleInlineError renders a recoverable validation message in place.
templ scheduleInlineError(testid, message string) {
	<div data-testid={ testid } role="alert" class="alert alert-error alert-soft">
		<span class="text-sm">{ message }</span>
	</div>
}

// scheduleAmountValue renders an item's amount for its input, blank when the
// item has none — a fresh declaration, or one left for the system to compute
// ([ADR-0031]).
func scheduleAmountValue(item schedule.Item) string {
	if item.Amount == nil {
		return ""
	}
	return strconv.FormatFloat(*item.Amount, 'f', -1, 64)
}

// scheduleDayValue renders the day-of-month input's value, blank when unset.
func scheduleDayValue(item schedule.Item) string {
	if item.DayOfMonth == 0 {
		return ""
	}
	return strconv.Itoa(item.DayOfMonth)
}

// scheduleAnchorValue renders the anchor date in the format an <input type=date>
// requires, blank when unset.
func scheduleAnchorValue(item schedule.Item) string {
	if item.AnchorDate.IsZero() {
		return ""
	}
	return item.AnchorDate.Format("2006-01-02")
}

// scheduleDirectionLabel names which way a declared item moves money through
// checking.
func scheduleDirectionLabel(d schedule.Direction) string {
	if d == schedule.DirectionIn {
		return "In"
	}
	return "Out"
}

// scheduleDirectionBadgeClass accents a direction the same way the rest of the
// app reads income against spending: income leans on the success hue, an
// outflow stays neutral.
func scheduleDirectionBadgeClass(d schedule.Direction) string {
	if d == schedule.DirectionIn {
		return "badge badge-sm badge-success badge-soft"
	}
	return "badge badge-sm badge-neutral"
}

// scheduleAmountLabel renders the amount a compact row shows: the resolved
// figure List already worked out — declared or computed, whichever applies —
// or an em dash when there is none to show at all ([ADR-0031]).
func scheduleAmountLabel(item schedule.Item) string {
	if item.Amount == nil {
		return "—"
	}
	return formatUSD(*item.Amount)
}

// scheduleAmountStateLabel names which of the four amount states an item is
// in, crossing whether an override is declared against whether a computed
// figure exists at all ([ADR-0031]).
func scheduleAmountStateLabel(state schedule.AmountState) string {
	switch {
	case !state.Override && state.Computed:
		return "forecast"
	case !state.Override && !state.Computed:
		return "no estimate"
	case state.Override && !state.Computed:
		return "manual"
	default:
		return "manual override"
	}
}

// scheduleCadenceSummary names how often a declared item recurs. A dateless
// monthly item has no fixed day to summarize instead, so it names its open
// month, switching to a settled-looking label once that month's occurrence is
// matched ([ADR-0031]).
func scheduleCadenceSummary(item schedule.Item, window schedule.ItemOccurrences) string {
	switch item.Cadence {
	case schedule.CadenceBiweekly:
		return "Every 2 weeks"
	case schedule.CadenceMonthly:
		if item.DayOfMonth < 1 {
			if scheduleDatelessMonthSettled(window) {
				return "This month, settled"
			}
			return "This month, any day"
		}
		return "Monthly on the " + scheduleOrdinalDay(item.DayOfMonth)
	default:
		return ""
	}
}

// scheduleDatelessMonthSettled reports whether a dateless item's open month
// has already been matched. The window's occurrences come back in ascending
// date order and reach no further forward than today, so the last one is
// always the current month's stand-in ([ADR-0031]). An item with no window at
// all — inactive, or nothing yet resolved this lookback — reads as still
// open, which is the safer default for a list that is otherwise silent about
// it.
func scheduleDatelessMonthSettled(window schedule.ItemOccurrences) bool {
	if len(window.Occurrences) == 0 {
		return false
	}
	return window.Occurrences[len(window.Occurrences)-1].Settled()
}

// scheduleOrdinalDay renders a day of the month with its ordinal suffix, e.g.
// 1 -> "1st", 2 -> "2nd", 11 -> "11th".
func scheduleOrdinalDay(day int) string {
	suffix := "th"
	if day%100 < 11 || day%100 > 13 {
		switch day % 10 {
		case 1:
			suffix = "st"
		case 2:
			suffix = "nd"
		case 3:
			suffix = "rd"
		}
	}
	return strconv.Itoa(day) + suffix
}
