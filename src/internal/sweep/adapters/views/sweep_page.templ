package views

import (
	"github.com/alecdray/two-cents/src/internal/core/templates"
	"github.com/alecdray/two-cents/src/internal/sweep"
)

// SweepPage renders the /sweep surface: the snapshot being viewed, and the
// schedule the next run will be built from. They are two independently
// swappable regions — running the sweep leaves the schedule alone, and editing
// the schedule leaves the snapshot alone.
templ SweepPage(snap sweep.Snapshot, found bool, sched ScheduleProps) {
	@templates.PageLayoutComponent(templates.PageLayoutProps{Title: "Sweep", Navbar: templates.AppNavbar(templates.NavSweep)}) {
		<main data-testid="sweep-page" class="w-full max-w-2xl flex flex-col gap-8 p-4 sm:p-6">
			<section id={ SweepRegionID() } class="flex flex-col gap-6">
				@SweepSnapshotFrag(snap, found, "")
			</section>
			@ScheduleFrag(sched)
		</main>
	}
}

// SweepSnapshotFrag is the swappable snapshot region: the snapshot being viewed
// and the controls that work the history. A run swaps this region rather than
// replacing the page, so a failed run can report itself in place — runError
// renders beside the control that caused it, leaving the snapshot in view.
templ SweepSnapshotFrag(snap sweep.Snapshot, found bool, runError string) {
	if !found {
		@sweepEmptyState()
	} else if snap.Recommendation.Kind == sweep.KindNumeric {
		@sweepNumericView(snap.Recommendation)
	} else {
		@sweepNeedsAttentionView(snap.Recommendation)
	}
	@sweepControls(snap, runError)
}

// sweepControls carries the two things that work the history: the action that
// produces a new snapshot, and the steps to the neighbouring ones. The steps are
// plain links, so every snapshot is addressable and shareable. A step is absent
// rather than disabled at the ends of the timeline — there is nowhere to go, and
// an empty id is exactly the "no snapshot that way" case (including before any
// run, where the whole snapshot is the zero value).
templ sweepControls(snap sweep.Snapshot, runError string) {
	<div data-testid="sweep-controls" class="flex flex-col gap-2 pt-2 border-t border-base-200">
		<div class="flex items-center justify-between gap-4">
			<div class="flex items-center gap-3">
				if snap.OlderID != "" {
					<a data-testid="sweep-older" href={ templ.SafeURL("/sweep/" + snap.OlderID) } class="text-sm text-primary hover:underline">← Older</a>
				}
				if snap.NewerID != "" {
					<a data-testid="sweep-newer" href={ templ.SafeURL("/sweep/" + snap.NewerID) } class="text-sm text-primary hover:underline">Newer →</a>
				}
			</div>
			<button
				data-testid="sweep-run"
				type="button"
				class="btn btn-primary btn-sm"
				hx-post="/sweep/run"
				hx-target={ "#" + SweepRegionID() }
				hx-swap="innerHTML"
				hx-vals={ sweepRunVals(snap.Recommendation.ID) }
			>Run now</button>
		</div>
		if runError != "" {
			<div data-testid="sweep-run-error" role="alert" class="alert alert-error alert-soft">
				<span class="text-sm">{ runError }</span>
			</div>
		}
	</div>
}

// sweepEmptyState is the first-run view shown before any recommendation has
// been computed and stored. It tells the user when to expect their first result.
templ sweepEmptyState() {
	<div data-testid="sweep-empty" class="flex flex-col items-center gap-4 py-12 text-center text-muted">
		<p class="text-lg font-medium">No recommendation yet</p>
		<p class="text-sm">Run one now, or wait for the monthly run on the 7th.</p>
	</div>
}

// sweepNumericView leads with the action headline, states the balances the
// figure rests on, and then shows the timeline that produced it — so the
// arithmetic is reconstructable from what's on screen.
templ sweepNumericView(rec sweep.Recommendation) {
	<section data-testid="sweep-numeric" class="flex flex-col gap-6">
		@sweepActionHeadline(rec)
		@sweepFigures(rec)
		@sweepTimeline(rec)
	</section>
}

// sweepActionHeadline renders the plain-language action line that leads the
// numeric view: the direction and the headline dollar amount, with the instant
// the recommendation was computed against.
templ sweepActionHeadline(rec sweep.Recommendation) {
	<div data-testid="sweep-action" class="flex flex-col gap-1">
		@sweepComputedAt(rec)
		<p data-testid="sweep-action-line" class="text-2xl font-bold text-default">
			{ sweepActionLine(rec) }
		</p>
	</div>
}

// sweepComputedAt names the instant the snapshot was computed against. Both
// snapshot kinds carry it — a needs-attention run is a real, navigable snapshot —
// so it is defined once here rather than twice.
templ sweepComputedAt(rec sweep.Recommendation) {
	<p data-testid="sweep-computed-at" class="text-xs font-medium uppercase tracking-wide text-muted">{ "Recommendation · " + sweepSnapshotLabel(rec) }</p>
}

// sweepFigures renders the balances and the two figures the headline is derived
// from — what has to stay put, and the cushion held beyond it.
templ sweepFigures(rec sweep.Recommendation) {
	<div data-testid="sweep-breakdown" class="flex flex-col gap-2">
		<p class="text-xs font-medium uppercase tracking-wide text-muted">Supporting figures</p>
		<dl class="flex flex-col gap-3">
			@figureRow("sweep-checking", "Current checking", formatUSD(rec.CurrentChecking))
			@figureRow("sweep-savings", "Current savings", sweepSavingsLabel(rec))
			@figureRow("sweep-required", "Must stay in checking", formatUSD(rec.RequiredChecking))
			@figureRow("sweep-safety-margin", "Safety margin", formatUSD(rec.FixedSafetyMargin))
		</dl>
	</div>
}

// figureRow renders a single labeled figure in the breakdown.
templ figureRow(testid, label, value string) {
	<div data-testid="sweep-figure-row" class="flex items-center justify-between gap-4 py-1 border-b border-base-200 last:border-0">
		<dt data-testid={ testid + "-label" } class="text-sm text-muted">{ label }</dt>
		<dd data-testid={ testid } class="text-sm font-medium tabular-nums text-default">{ value }</dd>
	</div>
}

// sweepTimeline shows the dated events the figure was computed from, with the
// running total each produced. The peak row is marked because it is the one that
// set the number — the whole answer is "the worst moment in the window", and
// this is where the reader sees which moment that was.
templ sweepTimeline(rec sweep.Recommendation) {
	<div data-testid="sweep-timeline" class="flex flex-col gap-2">
		<p class="text-xs font-medium uppercase tracking-wide text-muted">{ sweepHorizonLabel(rec) }</p>
		if len(rec.Timeline) == 0 {
			<p data-testid="sweep-timeline-empty" class="text-sm text-muted py-2">
				Nothing falls due in the next month, so none of your checking balance is spoken for.
			</p>
		} else {
			<div class="overflow-x-auto">
				<table class="table table-sm">
					<thead>
						<tr>
							<th class="text-muted font-medium">Date</th>
							<th class="text-muted font-medium">What</th>
							<th class="text-muted font-medium text-right">Amount</th>
							<th class="text-muted font-medium text-right">Running</th>
						</tr>
					</thead>
					<tbody>
						for _, event := range rec.Timeline {
							@sweepTimelineRow(event)
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// sweepTimelineRow renders one dated event and the running total it produced.
templ sweepTimelineRow(event sweep.TimelineEvent) {
	<tr data-testid="sweep-timeline-row" class={ sweepRowClass(event) }>
		<td data-testid="sweep-timeline-date" class="whitespace-nowrap text-muted">{ sweepEventDate(event) }</td>
		<td data-testid="sweep-timeline-label" class="text-default">
			{ event.Label }
			if event.Peak {
				<span data-testid="sweep-timeline-peak" class="badge badge-sm badge-warning ml-2">peak</span>
			}
		</td>
		<td data-testid="sweep-timeline-amount" class="text-right tabular-nums whitespace-nowrap">{ sweepEventAmount(event) }</td>
		<td data-testid="sweep-timeline-running" class="text-right tabular-nums whitespace-nowrap font-medium">{ formatUSD(event.RunningTotal) }</td>
	</tr>
}

// sweepNeedsAttentionView renders the reasons a numeric recommendation cannot
// be produced. Every reason stored on the result is listed so the user knows
// exactly what needs to be resolved, with a link to Accounts where designations
// can be corrected.
templ sweepNeedsAttentionView(rec sweep.Recommendation) {
	<section data-testid="sweep-needs-attention" class="flex flex-col gap-4">
		<p class="text-lg font-semibold text-warning">Recommendation unavailable</p>
		@sweepComputedAt(rec)
		<p class="text-sm text-muted">A sweep needs a checking balance, and a balance for every card, that it can stand behind. Resolve the following, then run the sweep again:</p>
		<ul class="flex flex-col gap-2 list-disc list-inside text-sm text-muted">
			for _, reason := range rec.Reasons {
				<li data-testid="sweep-reason">{ sweepReasonLabel(reason) }</li>
			}
		</ul>
		<a href="/accounts" class="text-sm text-primary hover:underline">Review account designations →</a>
	</section>
}
