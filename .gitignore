#   git config core.hooksPath .githooks
CLAUDE.md
.claude

# Build output / scratch
node_modules/
bin/
tmp/
*_templ.go

# Generated CSS (built by tailwind)
static/public/main.css

# Playwright
test-results/
playwright-report/
.playwright-mcp/
e2e/.auth/

# Working artifacts from skills (/build, /to-issues, etc.) — never commit.
tmp/specs/
tmp/plans/

# Brainstorming visual companion (machine-local)
.superpowers/
